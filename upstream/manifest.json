{
  "action": {
    "default_icon": {
      "128": "icons/128.png",
      "256": "icons/256.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "64": "icons/64.png"
    },
    "default_popup": "popup.html",
    "default_title": "欧文翻译"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "openAiWritingModal": {
      "description": "__MSG_legacyShortcut_openAiWritingModal__"
    },
    "toggleMouseHoverTranslateDirectly": {
      "description": "__MSG_legacyShortcut_toggleMouseHoverTranslateDirectly__"
    },
    "toggleOnlyTransation": {
      "description": "__MSG_legacyShortcut_toggleOnlyTransation__"
    },
    "toggleSidePanel": {
      "description": "__MSG_toggleSidePanel__",
      "suggested_key": {
        "default": "Alt+S"
      }
    },
    "toggleTranslatePage": {
      "description": "__MSG_toggleTranslatePageOfficialPage__",
      "suggested_key": {
        "default": "Alt+A"
      }
    },
    "toggleTranslateTheMainPage": {
      "description": "__MSG_legacyShortcut_toggleTranslateTheMainPage__"
    },
    "toggleTranslateTheWholePage": {
      "description": "__MSG_legacyShortcut_toggleTranslateTheWholePage__",
      "suggested_key": {
        "default": "Alt+W"
      }
    },
    "toggleTranslateToThePageEndImmediately": {
      "description": "__MSG_legacyShortcut_toggleTranslateToThePageEndImmediately__"
    },
    "toggleTranslationMask": {
      "description": "__MSG_legacyShortcut_toggleTranslationMask__"
    },
    "toggleVideoSubtitlePreTranslation": {
      "description": "__MSG_legacyShortcut_toggleVideoSubtitlePreTranslation__"
    },
    "translateInputBox": {
      "description": "__MSG_legacyShortcut_translateInputBox__",
      "suggested_key": {
        "default": "Alt+I"
      }
    },
    "translateWithBing": {
      "description": "__MSG_legacyShortcut_translateWithBing__"
    },
    "translateWithClaude": {
      "description": "__MSG_legacyShortcut_translateWithClaude__"
    },
    "translateWithCustom1": {
      "description": "__MSG_legacyShortcut_translateWithCustom1__"
    },
    "translateWithCustom2": {
      "description": "__MSG_legacyShortcut_translateWithCustom2__"
    },
    "translateWithCustom3": {
      "description": "__MSG_legacyShortcut_translateWithCustom3__"
    },
    "translateWithDeepL": {
      "description": "__MSG_legacyShortcut_translateWithDeepL__"
    },
    "translateWithGemini": {
      "description": "__MSG_legacyShortcut_translateWithGemini__"
    },
    "translateWithGoogle": {
      "description": "__MSG_legacyShortcut_translateWithGoogle__"
    },
    "translateWithOpenAI": {
      "description": "__MSG_legacyShortcut_translateWithOpenAI__"
    },
    "translateWithTransmart": {
      "description": "__MSG_legacyShortcut_translateWithTransmart__"
    }
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "content_guard.js"
      ],
      "match_about_blank": true,
      "matches": [
        "<all_urls>",
        "file:///*",
        "*://*/*"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "enabled": true,
        "id": "ruleset_1",
        "path": "request_modifier_rule.json"
      }
    ]
  },
  "default_locale": "en",
  "description": "网页双语翻译与视频字幕翻译，支持 Magpie 本机智能分句。",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/128.png",
    "256": "icons/256.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png"
  },
  "manifest_version": 3,
  "name": "欧文翻译",
  "options_page": "magpie-settings.html",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "declarativeNetRequest",
    "offscreen",
    "sidePanel"
  ],
  "version": "1.34.3",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>",
        "file:///*",
        "*://*/*"
      ],
      "resources": [
        "styles/inject.css",
        "pdf/index.html",
        "video-subtitle/inject.js",
        "image/inject.js",
        "tesseract/worker.min.js",
        "tesseract/tesseract-core-simd-lstm.wasm.js",
        "browser-bridge/inject.js",
        "side-panel.html",
        "default_config.json",
        "default_config.content.json",
        "content_main.js",
        "locales.json"
      ]
    }
  ],
  "version_name": "1.34.3 + Owen 0.1",
  "short_name": "欧文翻译"
}
